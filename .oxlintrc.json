{
  "plugins": ["jsdoc", "import", "jest", "promise", "node"],
  "rules": {
    "no-console": "error",

    // Disable rules redundant with TypeScript strict mode
    "no-dupe-class-members": "off",
    "no-func-assign": "off",
    "no-const-assign": "off",
    "no-class-assign": "off",
    "no-import-assign": "off",
    "no-obj-calls": "off",
    "no-setter-return": "off",
    "no-this-before-super": "off",
    "no-unsafe-negation": "off",
    "no-unsafe-optional-chaining": "off",
    "valid-typeof": "off",
    "no-dupe-keys": "off",
    "no-duplicate-case": "off",
    "no-empty-pattern": "off",
    "no-ex-assign": "off",
    "no-loss-of-precision": "off",
    "no-useless-rename": "off",
    "no-fallthrough": "off",
    "no-global-assign": "off",
    "no-new-symbol": "off",
    "no-redeclare": "off",
    "no-undef": "off",
    "no-unreachable": "off",
    "use-isnan": "off",
    "no-unused-vars": "off"
  },
  "ignore": ["dist/**", "node_modules/**", "**/*.d.ts", "coverage/**"]
}
